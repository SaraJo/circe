{
  "name": "circe-website",
  "version": "0.0.0",
  "private": true,
  "description": "Circe documentation site, deployed to GitHub Pages",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "prestart": "npm run sync",
    "start": "docusaurus start",
